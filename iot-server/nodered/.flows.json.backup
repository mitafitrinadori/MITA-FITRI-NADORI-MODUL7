    {
        "id": "b46fca8102f85d34",
        "type": "function",
        "z": "d897b73236221626",
        "name": "function 1",
        "func": "// Membaca suhu dari data yang diterima\nlet suhu = Number(msg.payload.suhu);\n\n// Mengambil kondisi LED sebelumnya\nlet led = context.get(\"led\") || 0;\n\n// Mengatur kondisi LED berdasarkan suhu\nif (suhu > 31.5) {\n    led = 1;  // LED menyala\n} else if (suhu < 30.0) {\n    led = 0;  // LED mati\n}\n\n// Menyimpan kondisi LED saat ini\ncontext.set(\"led\", led);\n\n// Mengirim hasil ke output\nmsg.payload = {\n    \"led\": led\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 220,
        "y": 300,
        "wires": [
            [
                "44fd846cbca7f1a2"
            ]
        ]
    }
]